<UserControl x:Class="AppClient.WpfPages.MahAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
    <!-- Loaded for THIS page only. Theme = Light or Dark, accent = Blue, Green, Purple, Orange ... -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="34,26">
        <TextBlock Text="Hello, World!" FontSize="40" FontWeight="Light"
                   Foreground="{DynamicResource MahApps.Brushes.Accent}" />
        <TextBlock Text="MahApps.Metro  ·  WPF  ·  Metro / Modern UI" FontSize="14" Opacity="0.7" Margin="0,4,0,24"
                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />

        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="txtName" Width="320" FontSize="14"
                     mah:TextBoxHelper.Watermark="Your name"
                     mah:TextBoxHelper.ClearTextButton="True" />
            <Button Content="Say hello" Margin="12,0,0,0" Padding="18,6" Click="SayHello_Click"
                    mah:ControlsHelper.ContentCharacterCasing="Normal"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" />
        </StackPanel>

        <TextBlock x:Name="lblGreeting" Text="Type your name and press the button." FontSize="15" Margin="0,22,0,16"
                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />

        <mah:ToggleSwitch x:Name="tglDark" Header="Dark mode" Toggled="Dark_Toggled" />
    </StackPanel>
</UserControl>
