<UserControl x:Class="AppClient.WpfPages.MaterialDesignPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesign.Brush.Background}"
             TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
             FontFamily="{materialDesign:MaterialDesignFont}">
    <!-- The library's theme is loaded for THIS page only, so it cannot clash with other libraries. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,22">
        <materialDesign:Card Padding="28" UniformCornerRadius="16" Width="600" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HandWave" Width="44" Height="44" VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <TextBlock Text="Hello, World!" FontSize="40" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="MaterialDesignInXamlToolkit  ·  WPF  ·  Material Design 3" Opacity="0.7" Margin="0,6,0,20" FontSize="14" />

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtName" Width="320" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Your name" />
                    <Button Content="SAY HELLO" Margin="16,0,0,0" VerticalAlignment="Center" Click="SayHello_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>

                <TextBlock x:Name="lblGreeting" Text="Type your name and press the button." FontSize="15" Margin="0,20,0,16" />

                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="tglDark" Style="{StaticResource MaterialDesignSwitchToggleButton}" Click="Dark_Click" />
                    <TextBlock Text="Dark mode" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
