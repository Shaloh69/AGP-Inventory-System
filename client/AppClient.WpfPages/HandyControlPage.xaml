<UserControl x:Class="AppClient.WpfPages.HandyControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Background="{DynamicResource SecondaryRegionBrush}">
    <!-- [0] skin (colours): SkinDefault / SkinDark / SkinViolet, [1] control styles. THIS page only. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="28,22" Padding="28" CornerRadius="10" Width="620" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource RegionBrush}" Effect="{StaticResource EffectShadow2}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hello, World!" FontSize="38" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <hc:Shield Subject="HandyControl" Status="3.5" Color="{DynamicResource PrimaryBrush}"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="HandyControl  ·  WPF  ·  80+ extra controls" FontSize="14" Margin="0,6,0,20"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

            <StackPanel Orientation="Horizontal">
                <hc:TextBox x:Name="txtName" Width="320" hc:InfoElement.Placeholder="Your name" />
                <Button Content="Say hello" Margin="12,0,0,0" Style="{StaticResource ButtonPrimary}" Click="SayHello_Click" />
            </StackPanel>

            <TextBlock x:Name="lblGreeting" Text="Type your name and press the button." FontSize="15" Margin="0,20,0,16"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="tglDark" Style="{StaticResource ToggleButtonSwitch}" Click="Dark_Click" />
                <TextBlock Text="Dark mode" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
