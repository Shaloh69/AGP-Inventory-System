<?xml version="1.0" encoding="utf-8"?>
<!--
  Packages for this project come only from nuget.org, whatever else is configured on the PC
  (extra or broken package sources, offline folders, source mapping rules). This avoids most
  "NuGet.targets ... Object reference not set to an instance of an object" restore errors.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
