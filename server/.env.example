# Copy this file to ".env" (same folder) and fill in your real values.
# .env is ignored by Git. NEVER commit real passwords.

# Port for local development. Render sets PORT automatically in production.
PORT=3000

# From Aiven Console -> your PostgreSQL service -> Overview -> Service URI
# IMPORTANT: remove "?sslmode=require" from the end; SSL is configured in src/config/db.js
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:12345/defaultdb

# Path to the Aiven CA certificate (download "CA certificate" from the Aiven Overview page)
# Local:  ./certs/ca.pem
# Render: /etc/secrets/ca.pem   (upload it as a Secret File named ca.pem)
DB_CA_PATH=./certs/ca.pem

# Only for a PostgreSQL running on your own PC (no SSL, no certificate). Leave it out for Aiven.
# DB_SSL=false

# Secret used to sign login tokens (only needed if you add login/JWT)
JWT_SECRET=change-me-to-a-long-random-string
