# Windows scripts must have Windows line endings (CRLF), or cmd.exe / PowerShell can misread them.
# This also applies to the "Download ZIP" button on GitHub.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Visual Studio files
*.sln  text eol=crlf
*.slnx text eol=crlf

# Binary files
*.png  binary
*.pdf  binary
